#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

compose() { docker compose -f "$ROOT/compose.yaml" "$@"; }
prod_compose() { docker compose -f "$ROOT/compose.production.yaml" "$@"; }

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  bootstrap)
    exec "$ROOT/scripts/bootstrap.sh" "$@"
    ;;
  up) compose up -d "$@" ;;
  down) compose down "$@" ;;
  restart) compose restart "$@" ;;
  status|ps) compose ps "$@" ;;
  logs) compose logs -f "$@" ;;
  shell) compose exec app bash "$@" ;;
  artisan)
    if [[ "${1:-}" == test ]]; then
      cat >&2 <<'EOF'

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! ACHTUNG: ./planer artisan test kann die normale MariaDB-Datenbank löschen !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

Verwende für Tests den sicheren Befehl:

  ./planer test [Testoptionen]

Dieser verwendet eine isolierte SQLite-In-Memory-Datenbank.
EOF
      confirmation=''
      if ! read -r -p 'Wirklich fortfahren? Tippe exakt "ja": ' confirmation < /dev/tty; then
        echo 'Abbruch: Keine interaktive Bestätigung erhalten.' >&2
        exit 2
      fi
      [[ "$confirmation" == ja ]] || { echo 'Abbruch: nicht bestätigt.' >&2; exit 2; }
    fi
    compose exec -e XDG_CONFIG_HOME=/tmp/config app php artisan "$@"
    ;;
  test)
    compose exec \
      -e APP_ENV=testing \
      -e DB_CONNECTION=sqlite \
      -e DB_DATABASE=:memory: \
      -e APP_KEY='base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=' \
      app php artisan test "$@"
    ;;
  composer) compose exec app composer "$@" ;;
  npm) compose run --rm vite npm "$@" ;;
  pint) compose exec app ./vendor/bin/pint "$@" ;;
  fresh)
    [[ "${1:-}" == --force ]] || { echo 'Abbruch: ./planer fresh löscht die lokale Datenbank. Nutze --force.' >&2; exit 2; }
    shift
    exec compose exec app php artisan migrate:fresh --seed --force "$@"
    ;;
  data)
    exec "$ROOT/scripts/data-sync.sh" "${1:-help}" "${@:2}"
    ;;
  backup)
    exec "$ROOT/scripts/backup.sh" "${1:-help}" "${@:2}"
    ;;
  migrate)
    [[ "${1:-}" == legacy ]] || { echo 'Verwendung: ./planer migrate legacy ...' >&2; exit 2; }
    shift
    exec "$ROOT/scripts/legacy-migrate.sh" "$@"
    ;;
  prod|production)
    PROD_COMMAND="${1:-help}"
    shift || true
    case "$PROD_COMMAND" in
      up) prod_compose up -d "$@" ;;
      down) prod_compose down "$@" ;;
      restart) prod_compose restart "$@" ;;
      status|ps) prod_compose ps "$@" ;;
      logs) prod_compose logs -f "$@" ;;
      exec) prod_compose exec "$@" ;;
      compose) prod_compose "$@" ;;
      update)
        exec "$ROOT/scripts/update-production.sh" "$@"
        ;;
      backup)
        PLANER_PRODUCTION=1 exec "$ROOT/scripts/backup.sh" "${1:-help}" "${@:2}"
        ;;
      *)
        cat >&2 <<'EOF'
Verwendung: ./planer prod up|down|restart|status|logs|exec|compose|backup|update
EOF
        exit 2
        ;;
    esac
    ;;
  *)
    cat <<'EOF'
Pfarrplaner-Entwicklungshelfer

Verwendung:
  ./planer up|down|restart|status|logs [Dienst]
  ./planer shell
  ./planer artisan <Befehl>
  ./planer test [Testoptionen]
  ./planer fresh --force
  ./planer data push|pull <ssh-path> [--source-down]
  ./planer backup create|list|verify|restore
  ./planer migrate legacy <ssh-path> [Optionen]
  ./planer prod up|down|restart|status|logs|exec|compose|backup|update
EOF
    ;;
esac
