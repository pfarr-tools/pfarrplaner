#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

compose() { docker compose -f "$ROOT/compose.yaml" "$@"; }
production_compose() {
  local args=( -f "$ROOT/compose.production.yaml" )
  if [[ "${MAIL_POSTFIX_ENABLED:-}" == true ]] || grep -q '^MAIL_POSTFIX_ENABLED=true$' "$ROOT/.env" 2>/dev/null; then
    args+=(--profile mail)
  fi
  docker compose "${args[@]}" "$@"
}

usage() {
  cat <<'EOF'
Pfarrplaner-Betriebshelfer

Produktion (Standard):
  ./planer up|down|restart|status|logs|exec [Argumente]
  ./planer build [--ref <tag|commit>]
  ./planer shell
  ./planer artisan <Befehl>
  ./planer backup create|list|verify|restore|prune|check|init
  ./planer migrate legacy <Pfad> [Optionen]
  ./planer install [--dev]
  ./planer bootstrap [--dev] (Alias)

Entwicklung:
  ./planer dev up|down|restart|status|logs|exec [Argumente]
  ./planer dev shell
  ./planer dev artisan <Befehl>
  ./planer dev test [Testoptionen]
  ./planer dev composer <Befehl>
  ./planer dev npm <Befehl>
  ./planer dev pint <Optionen>
  ./planer dev format|format:check|analyse|docs:check|lint|quality
  ./planer dev fresh --force
  ./planer dev manual build|dusk|site|all|deploy|source-publish
  ./planer dev manual:build|manual:dusk|manual:site|manual:all|manual:deploy|manual:source-publish

Der explizite Alias ./planer prod ... bleibt für Produktion erhalten.
EOF
}

run_dev() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    up) compose up "$@" ;;
    down) compose down "$@" ;;
    restart) compose restart "$@" ;;
    status|ps) compose ps "$@" ;;
    logs) compose logs -f "$@" ;;
    exec)
      local exec_args=("$@")
      local exec_arg_index
      for ((exec_arg_index = 0; exec_arg_index < ${#exec_args[@]} - 3; exec_arg_index++)); do
        if [[ "${exec_args[exec_arg_index]}" == app \
          && "${exec_args[exec_arg_index + 1]}" == php \
          && "${exec_args[exec_arg_index + 2]}" == artisan \
          && "${exec_args[exec_arg_index + 3]}" == test ]]; then
          cat >&2 <<'EOF'

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! ACHTUNG: Dieser Aufruf kann die normale MariaDB-Datenbank löschen          !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

Verwende für Tests den sicheren Befehl:

  ./planer dev test [Testoptionen]
EOF
          exit 2
        fi
      done
      compose exec "${exec_args[@]}"
      ;;
    shell) compose exec app bash "$@" ;;
    artisan)
      if [[ "${1:-}" == test ]]; then
        cat >&2 <<'EOF'

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! ACHTUNG: artisan test kann die normale MariaDB-Datenbank löschen            !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

Verwende für Tests den sicheren Befehl:

  ./planer dev test [Testoptionen]
EOF
        local confirmation=''
        read -r -p 'Wirklich fortfahren? Tippe exakt "ja": ' confirmation < /dev/tty || {
          echo 'Abbruch: Keine interaktive Bestätigung erhalten.' >&2
          exit 2
        }
        [[ "$confirmation" == ja ]] || { echo 'Abbruch: nicht bestätigt.' >&2; exit 2; }
      fi
      compose exec -e XDG_CONFIG_HOME=/tmp/config app php artisan "$@"
      ;;
    test)
      local test_status=0
      compose exec \
        -e APP_ENV=testing \
        -e DB_CONNECTION=sqlite \
        -e DB_DATABASE=:memory: \
        -e APP_KEY='base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=' \
        app php artisan test "$@" || test_status=$?
      compose exec -T -u 0 app sh -c \
        'if [ -e storage/logs/query.log ]; then chmod 666 storage/logs/query.log; fi'
      return "$test_status"
      ;;
    composer) compose exec app composer "$@" ;;
    npm) compose run --rm vite npm "$@" ;;
    pint) compose exec app ./vendor/bin/pint "$@" ;;
    format) compose exec app composer format; compose run --rm vite npm run format ;;
    format:check)
      compose exec app composer format:check
      compose run --rm vite npm run format:check
      compose run --rm vite npm run format:blade:check
      ;;
    analyse) compose exec app composer analyse ;;
    docs:check)
      compose exec app composer docs:check
      compose run --rm vite npm run docs:check
      ;;
    lint) compose run --rm vite npm run lint ;;
    quality)
      local quality_files=''
      quality_files="$(git diff --name-only "${QUALITY_BASE_REF:-origin/main}...HEAD" 2>/dev/null || git diff --name-only HEAD~1)"
      quality_files+=$'\n'"$(git diff --name-only HEAD)"
      quality_files+=$'\n'"$(git ls-files --others --exclude-standard)"
      quality_files="$(printf '%s\n' "$quality_files" | sed '/^$/d; s#^src/##' | sort -u)"
      local format_quality_files=''
      format_quality_files="$(printf '%s\n' "$quality_files" | sed -n '/\.(blade\.php\|css\|js\|json\|mjs\|sass\|scss\|vue\|yaml\|yml)$/p')"
      local js_quality_files=''
      js_quality_files="$(printf '%s\n' "$format_quality_files" | sed -n '/\.(js\|mjs\|vue)$/p' | sort -u)"
      QUALITY_FILES="$format_quality_files" run_dev format:check
      run_dev analyse
      QUALITY_FILES="$js_quality_files" run_dev docs:check
      QUALITY_FILES="$js_quality_files" run_dev lint
      run_dev complexity:check
      run_dev test --no-browser --no-js
      compose run --rm vite npm run test:js:run
      compose run --rm vite npm run build
      ;;
    complexity:check) compose exec app composer complexity:check ;;
    manual) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" "${1:-help}" "${@:2}" ;;
    manual:build) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" build "$@" ;;
    manual:dusk) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" dusk "$@" ;;
    manual:site) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" site "$@" ;;
    manual:all) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" all "$@" ;;
    manual:deploy) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" deploy "$@" ;;
    manual:source-publish) PLANER_MANUAL_DEV=1 exec "$ROOT/scripts/manual.sh" source-publish "$@" ;;
    fresh)
      [[ "${1:-}" == --force ]] || { echo 'Abbruch: ./planer dev fresh löscht die lokale Datenbank. Nutze --force.' >&2; exit 2; }
      shift
      compose exec app php artisan migrate:fresh --seed --force "$@"
      ;;
    data) PLANER_DEVELOPMENT=1 exec "$ROOT/scripts/data-sync.sh" "$@" ;;
    help|--help|-h) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

run_production() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    up) production_compose up "$@" ;;
    down) production_compose down "$@" ;;
    restart) production_compose restart "$@" ;;
    status|ps) production_compose ps "$@" ;;
    logs) production_compose logs -f "$@" ;;
    exec) production_compose exec "$@" ;;
    shell) production_compose exec app bash "$@" ;;
    artisan) production_compose exec -e XDG_CONFIG_HOME=/tmp/config app php artisan "$@" ;;
    data) PLANER_PRODUCTION=1 exec "$ROOT/scripts/data-sync.sh" "$@" ;;
    backup) PLANER_PRODUCTION=1 exec "$ROOT/scripts/backup.sh" "${1:-help}" "${@:2}" ;;
    release) exec "$ROOT/scripts/release.sh" "$@" ;;
    update) exec "$ROOT/scripts/update-production.sh" "$@" ;;
    build) exec "$ROOT/scripts/build-production.sh" "$@" ;;
    migrate)
      [[ "${1:-}" == legacy ]] || { echo 'Verwendung: ./planer migrate legacy ...' >&2; exit 2; }
      shift
      exec "$ROOT/scripts/legacy-migrate.sh" "$@" --prod
      ;;
    install|bootstrap) exec "$ROOT/scripts/bootstrap.sh" "$@" ;;
    help|--help|-h) usage ;;
  test|composer|npm|pint|format|format:check|analyse|docs:check|lint|quality|complexity:check|fresh)
      echo "Fehler: '$command' ist ein Entwicklungsbefehl. Verwende ./planer dev $command ..." >&2
      exit 2
      ;;
    *) usage >&2; exit 2 ;;
  esac
}

COMMAND="${1:-help}"
shift || true
case "$COMMAND" in
  dev) run_dev "$@" ;;
  prod|production) run_production "$@" ;;
  install|bootstrap) exec "$ROOT/scripts/bootstrap.sh" "$@" ;;
  manual|manual:build|manual:dusk|manual:site|manual:all|manual:deploy|manual:source-publish)
    run_dev "$COMMAND" "$@" ;;
  up|down|restart|status|ps|logs|exec|shell|artisan|data|backup|release|update|build|migrate|test|composer|npm|pint|fresh)
    run_production "$COMMAND" "$@"
    ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
