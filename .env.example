# Name shown in the application and generated emails.
APP_NAME=Pfarrplaner
# Runtime environment: local, testing, or production.
APP_ENV=local
# Laravel encryption key; bootstrap generates this automatically.
APP_KEY=
# Show detailed errors; keep false in production.
APP_DEBUG=true
# Public URL used for links, cookies, and callbacks.
APP_URL=http://localhost:8180
# Public application port for the local or host-level reverse proxy.
APP_PORT=8180
# Vite development server port.
VITE_PORT=5273
# Host announced to the Vite browser client.
VITE_HMR_HOST=localhost
# Protocol announced to the Vite browser client.
VITE_HMR_PROTOCOL=http
# Browser-facing Vite HMR port.
VITE_HMR_CLIENT_PORT=5273
# Octane application server implementation.
OCTANE_SERVER=swoole
# Tell Octane whether the application is served over HTTPS.
OCTANE_HTTPS=false
# Number of Octane workers.
OCTANE_WORKERS=4
# Requests handled by one Octane worker before it restarts.
OCTANE_MAX_REQUESTS=500
# Comma-separated email addresses allowed to open Horizon.
HORIZON_ALLOWED_EMAILS=
# Optional Horizon hostname.
HORIZON_DOMAIN=
# Optional Horizon display name.
HORIZON_NAME=Horizon
# URL path for Horizon.
HORIZON_PATH=horizon
# Application administrator email address.
APP_ADMINISTRATOR=
# Optional support/developer notification suppression flag.
NO_PING=
# Optional instance identifier used by development tooling.
THIS_IS_MY_DEV_HOST=
# Trusted proxy configuration for forwarded HTTPS and host headers.
TRUST_PROXY=
# Asset URL when assets are served from another host or CDN.
ASSET_URL=
# Path to the shared administrator and technical manuals.
PFARRPLANER_MANUAL_ROOT=/var/www/docs/manual
# Public URL of the manuals.
MANUAL_URL=https://handbuch.pfarrplaner.de
# Additional salt for application tokens.
TOKEN_SALT=
# Logging channel.
LOG_CHANNEL=stack
# Log formatter used for stderr output.
LOG_STDERR_FORMATTER=
# Remote Papertrail URL, if centralized logging is used.
PAPERTRAIL_URL=
# Remote Papertrail port, if centralized logging is used.
PAPERTRAIL_PORT=
# Editor link used by Ignition error pages.
IGNITION_EDITOR=
# Enable runnable Ignition solutions.
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false
# Prefix for the Ignition housekeeping endpoint.
IGNITION_HOUSEKEEPING_ENDPOINT_PREFIX=_ignition
# Optional Ignition settings file.
IGNITION_SETTINGS_FILE_PATH=
# Allow sharing Ignition error reports.
IGNITION_SHARING_ENABLED=false
# Ignition error page theme.
IGNITION_THEME=light
# Include stack frames on Ignition error pages.
IGNITION_WITH_STACK_FRAME_ARGUMENTS=true
# Allow registration of Ignition commands.
REGISTER_IGNITION_COMMANDS=false
# Password hashing cost.
BCRYPT_ROUNDS=12

# Database driver.
DB_CONNECTION=mysql
# Database hostname inside the Compose network.
DB_HOST=mariadb
# Database port inside the Compose network.
DB_PORT=3306
# Host-side database port for development diagnostics.
FORWARD_DB_PORT=53306
# Database name.
DB_DATABASE=pfarrplaner
# Database user.
DB_USERNAME=pfarrplaner
# Database password; bootstrap generates this automatically.
DB_PASSWORD=change-me
# Database root password; bootstrap generates this automatically.
DB_ROOT_PASSWORD=change-root-me
# Optional database Unix socket.
DB_SOCKET=
# Enable database foreign-key checks.
DB_FOREIGN_KEYS=true
# Enable database field encryption.
DB_ENCRYPTION_ENABLED=true
# Prefix for encrypted database values.
DB_ENCRYPTION_PREFIX=encrypted:
# Encryption format version for encrypted database values.
DB_ENCRYPTION_VERSIONING=1
# Application database encryption key; bootstrap generates this automatically.
DATABASE_KEY=
# Cipher used for encrypted database values.
DATABASE_CIPHER=AES-256-CBC

# Redis hostname inside the Compose network.
REDIS_HOST=redis
# Redis port.
REDIS_PORT=6379
# Redis password; bootstrap generates this automatically.
REDIS_PASSWORD=change-redis-password
# Redis client implementation.
REDIS_CLIENT=predis
# Redis database number for default cache connections.
REDIS_DB=0
# Redis database number for cache connections.
REDIS_CACHE_DB=1
# Redis database number for queues.
REDIS_QUEUE=2
# Prefix for Redis keys.
CACHE_PREFIX=pfarrplaner
# Queue backend.
QUEUE_CONNECTION=redis
# Cache backend.
CACHE_STORE=redis
# Legacy cache backend setting.
CACHE_DRIVER=redis
# Session backend.
SESSION_DRIVER=database
# Optional session database connection.
SESSION_CONNECTION=
# Session lifetime in minutes.
SESSION_LIFETIME=1500
# Optional session store name.
SESSION_STORE=
# Session cookie domain.
SESSION_DOMAIN=
# Mark session cookies as HTTPS-only.
SESSION_SECURE_COOKIE=

# Filesystem backend.
FILESYSTEM_DRIVER=s3
# Default cloud filesystem disk.
FILESYSTEM_CLOUD=s3
# S3-compatible access key.
AWS_ACCESS_KEY_ID=pfarrplaner
# S3-compatible secret key; bootstrap generates this automatically.
AWS_SECRET_ACCESS_KEY=change-object-storage-secret
# S3 region.
AWS_DEFAULT_REGION=us-east-1
# Live object-storage bucket.
AWS_BUCKET=pfarrplaner
# MinIO or S3 endpoint.
AWS_ENDPOINT=http://minio:9000
# Use path-style S3 URLs for MinIO.
AWS_USE_PATH_STYLE_ENDPOINT=true
# Legacy AWS access key, if an integration requires it.
AWS_ID=
# Legacy AWS secret, if an integration requires it.
AWS_SECRET=
# Backup object-storage region.
BACKUP_S3_DEFAULT_REGION=us-east-1
# Backup object-storage endpoint.
BACKUP_S3_ENDPOINT=
# Backup object-storage access key.
BACKUP_S3_ACCESS_KEY_ID=
# Backup object-storage secret key.
BACKUP_S3_SECRET_ACCESS_KEY=
# Use path-style URLs for the backup object store.
BACKUP_S3_USE_PATH_STYLE_ENDPOINT=false
# MinIO bucket used for internal backup copies.
MINIO_BACKUP_BUCKET=pfarrplaner-backups
# Host-side MinIO API port for development diagnostics.
FORWARD_S3_PORT=9900
# Host-side MinIO console port for development diagnostics.
FORWARD_S3_CONSOLE_PORT=9901

# Broadcast backend.
BROADCAST_DRIVER=pusher
# Soketi application identifier.
PUSHER_APP_ID=pfarrplaner
# Soketi application key; bootstrap generates this automatically.
PUSHER_APP_KEY=change-pusher-key
# Soketi application secret; bootstrap generates this automatically.
PUSHER_APP_SECRET=change-pusher-secret
# Optional Pusher cluster.
PUSHER_APP_CLUSTER=mt1
# Soketi hostname inside the Compose network.
PUSHER_HOST=soketi
# Soketi port.
PUSHER_PORT=6001
# Soketi protocol.
PUSHER_SCHEME=http
# Frontend build variable containing the Pusher application key.
MIX_PUSHER_APP_KEY=${PUSHER_APP_KEY}
# Frontend build variable containing the Pusher cluster.
MIX_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}
# Host-side Soketi port for development diagnostics.
SOKETI_PORT=6601
# Enable verbose Soketi logging.
SOKETI_DEBUG=false

# Mail transport.
MAIL_MAILER=smtp
# Mail server hostname.
MAIL_HOST=mailpit
# Mail server port.
MAIL_PORT=1025
# Mail server username.
MAIL_USERNAME=
# Mail server password.
MAIL_PASSWORD=
# Mail encryption mode.
MAIL_ENCRYPTION=
# Sender email address.
MAIL_FROM_ADDRESS=pfarrplaner@example.test
# Sender display name.
MAIL_FROM_NAME=Pfarrplaner
# Host-side Mailpit port for local development.
FORWARD_MAILPIT_PORT=9825
# Legacy mail driver setting.
MAIL_DRIVER=smtp
# Email address used for development error notifications.
DEV_EMAIL=
# Suppress Sneaker background-job notifications.
SNEAKER_SILENT=false
# Mail log channel, if enabled.
MAIL_LOG_CHANNEL=
# Mailgun domain.
MAILGUN_DOMAIN=
# Mailgun endpoint.
MAILGUN_ENDPOINT=
# Mailgun secret.
MAILGUN_SECRET=
# Amazon SES access key.
SES_KEY=
# Amazon SES region.
SES_REGION=
# Amazon SES secret.
SES_SECRET=
# SparkPost secret.
SPARKPOST_SECRET=
# SQS access key.
SQS_KEY=
# SQS secret.
SQS_SECRET=
# SQS region.
SQS_REGION=
# SQS queue prefix.
SQS_PREFIX=
# SQS queue name.
SQS_QUEUE=

# Backup archive encryption password; bootstrap generates this automatically.
BACKUP_ARCHIVE_PASSWORD=change-backup-archive-password
# Email recipient for backup reports.
BACKUP_EMAIL_RECIPIENT=
# Local backup directory.
BACKUP_LOCAL_PATH=/var/backups/pfarrplaner
# Backup object-storage bucket.
BACKUP_S3_BUCKET=pfarrplaner-backups
# Backup disks used by Laravel Backup.
BACKUP_DISKS=local-backup,backup-s3
# SFTP backup hostname.
SFTP_BACKUP_HOST=
# SFTP backup username.
SFTP_BACKUP_USER=
# SFTP backup password.
SFTP_BACKUP_PASSWORD=
# SFTP backup root directory.
SFTP_BACKUP_ROOT=
# Filesystem path used for an FTP inbox integration.
FTP_INBOX_STORAGE_PATH=

# Memcached hostname, when Memcached is selected as a cache backend.
MEMCACHED_HOST=
# Memcached port.
MEMCACHED_PORT=11211
# Memcached username.
MEMCACHED_USERNAME=
# Memcached password.
MEMCACHED_PASSWORD=
# Memcached persistent connection identifier.
MEMCACHED_PERSISTENT_ID=

# Optional send-only mail relay hostname.
MAIL_RELAY_HOST=smtp.example.org
# Optional send-only mail relay port.
MAIL_RELAY_PORT=587
# Optional mail relay username.
MAIL_RELAY_USER=
# Optional mail relay password.
MAIL_RELAY_PASSWORD=
# Hostname used by the Postfix relay.
MAIL_MYHOSTNAME=pfarrplaner-mail.example.org
# Mail mode used by the Postfix container.
MAIL_MODE=relay
# Enable DKIM signing in the Postfix container.
DKIM_ENABLED=0
# DKIM signing domain.
DKIM_DOMAIN=
# DKIM selector.
DKIM_SELECTOR=default
# Path to the DKIM private key inside the Postfix container.
DKIM_PRIVATE_KEY_FILE=/run/secrets/dkim.key

# Administrator role label for organists.
LABEL_ORGANIST=Organist
# Administrator role label for pastors.
LABEL_PASTOR=Pfarrer/in
# Administrator role label for preachers.
LABEL_PREDICANT=Prädikant/in
# Administrator role label for sacristans.
LABEL_SACRISTAN=Mesner/in
# Default organization code for organists.
CODE_ORGANIST=O
# Default organization code for pastors.
CODE_PASTOR=P
# Default organization code for preachers.
CODE_PREDICANT=Pr
# Default organization code for sacristans.
CODE_SACRISTAN=M

# Vacation calendar federal state.
VACATION_STATE=BW
# YouTube channel feed URL.
YT_CHANNEL_FEED=https://www.youtube.com/feeds/videos.xml?channel_id=UCLRinVsLiYMJtN56bynCPEw
# Repository commit feed URL.
REPO_COMMIT_FEED=https://github.com/pfarrplaner/pfarrplaner/commits/main.atom
# Blog feed URL.
BLOG_FEED=
# Pixabay API key.
PIXABAY_API_KEY=
# reCAPTCHA site key.
RECAPTCHA_KEY=
# reCAPTCHA secret key.
RECAPTCHA_SECRET=
# Matomo site identifier.
MATOMO_SITE=

# Amazon API key.
AMAZON_API_KEY=
# Amazon API secret.
AMAZON_API_SECRET_KEY=
# Amazon Associates tag.
AMAZON_ASSOCIATE_TAG=
# Amazon API hostname.
AMAZON_HOST=
# Amazon API region.
AMAZON_REGION=
# Stripe public key.
STRIPE_KEY=
# Stripe secret key.
STRIPE_SECRET=
# Stripe webhook secret.
STRIPE_WEBHOOK_SECRET=
# Stripe webhook tolerance in seconds.
STRIPE_WEBHOOK_TOLERANCE=300
# Auth0 client ID.
AUTH0_CLIENT_ID=
# Auth0 client secret.
AUTH0_CLIENT_SECRET=
# Auth0 domain.
AUTH0_DOMAIN=

# Optional build identifier.
BUILD_NUMBER=
# Optional application build label.
APP_BUILD=
# Optional build date.
BUILD_DATE=
# Optional build repository URL.
BUILD_REPOSITORY=
# Optional build URL.
BUILD_URL=
# Optional application provider override.
APP_PROVIDER=
# Optional browser logging watcher for Laravel Boost.
BOOST_BROWSER_LOGS_WATCHER=
# Enable Laravel Boost.
BOOST_ENABLED=false
# Composer executable used by Laravel Boost.
BOOST_COMPOSER_EXECUTABLE_PATH=
# Current-directory executable used by Laravel Boost.
BOOST_CURRENT_DIRECTORY_EXECUTABLE_PATH=
# Node executable used by Laravel Boost.
BOOST_NPM_EXECUTABLE_PATH=
# PHP executable used by Laravel Boost.
BOOST_PHP_EXECUTABLE_PATH=
# Vendor-bin executable used by Laravel Boost.
BOOST_VENDOR_BIN_EXECUTABLE_PATH=

# Enable Telescope.
TELESCOPE_ENABLED=false
# Telescope storage driver.
TELESCOPE_DRIVER=database
# Telescope hostname.
TELESCOPE_DOMAIN=
# Telescope URL path.
TELESCOPE_PATH=telescope
# Telescope queue name.
TELESCOPE_QUEUE=
# Telescope queue connection.
TELESCOPE_QUEUE_CONNECTION=
# Telescope queue delay.
TELESCOPE_QUEUE_DELAY=0
# Enable Telescope batch watcher.
TELESCOPE_BATCH_WATCHER=false
# Enable Telescope cache watcher.
TELESCOPE_CACHE_WATCHER=false
# Enable Telescope client-request watcher.
TELESCOPE_CLIENT_REQUEST_WATCHER=false
# Enable Telescope command watcher.
TELESCOPE_COMMAND_WATCHER=false
# Enable Telescope dump watcher.
TELESCOPE_DUMP_WATCHER=false
# Always enable Telescope dump watcher.
TELESCOPE_DUMP_WATCHER_ALWAYS=false
# Enable Telescope event watcher.
TELESCOPE_EVENT_WATCHER=false
# Enable Telescope exception watcher.
TELESCOPE_EXCEPTION_WATCHER=false
# Enable Telescope gate watcher.
TELESCOPE_GATE_WATCHER=false
# Enable Telescope job watcher.
TELESCOPE_JOB_WATCHER=false
# Enable Telescope log watcher.
TELESCOPE_LOG_WATCHER=false
# Enable Telescope mail watcher.
TELESCOPE_MAIL_WATCHER=false
# Enable Telescope model watcher.
TELESCOPE_MODEL_WATCHER=false
# Enable Telescope notification watcher.
TELESCOPE_NOTIFICATION_WATCHER=false
# Enable Telescope Redis watcher.
TELESCOPE_REDIS_WATCHER=false
# Enable Telescope request watcher.
TELESCOPE_REQUEST_WATCHER=false
# Enable Telescope query watcher.
TELESCOPE_QUERY_WATCHER=false
# Maximum response size recorded by Telescope.
TELESCOPE_RESPONSE_SIZE_LIMIT=64
# Enable Telescope schedule watcher.
TELESCOPE_SCHEDULE_WATCHER=false
# Enable Telescope view watcher.
TELESCOPE_VIEW_WATCHER=false
