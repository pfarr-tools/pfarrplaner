{
    "name": "potofcoffee/pfarrplaner",
    "type": "project",
    "description": "Eine kollaborative Plattform, die es evangelischen Kirchengemeinden erlaubt, gemeinsam Gottesdienste zu planen, Urlaubskalender zu verwalten und Kasualien zu bearbeiten.",
    "license": "GPL-3.0-or-later",
    "version": "2023.25.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/potofcoffee/laravel-database-encryption.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-ide-helper": "^3.0",
        "doctrine/dbal": "^3.0",
        "google/apiclient": "^2.0",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel-lang/lang": "~9.0",
        "laravel/framework": "^11.0",
        "laravel/octane": "2.11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.6.1",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "~3.10",
        "league/flysystem-sftp-v3": "~3.10",
        "nesbot/carbon": "^3.0",
        "phpoffice/phppresentation": "^1.2.0",
        "phpoffice/phpspreadsheet": "^1.8",
        "phpoffice/phpword": "^1.2.0",
        "predis/predis": "^1.1",
        "psr/log": "^2",
        "sabre/dav": "^4.4",
        "simshaun/recurr": "^5.0",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-backup": "^8.1.5",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-permission": "^6.12",
        "spiral/roadrunner-cli": "*",
        "spiral/roadrunner-http": "*",
        "staudenmeir/belongs-to-through": "^2.3",
        "tightenco/ziggy": "^1.0"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^2.0",
        "fakerphp/faker": "^1.24",
        "filp/whoops": "^2.0",
        "laravel/dusk": "^8.0",
        "laravel/legacy-factories": "^1.1",
        "laravel/telescope": "^5.10",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.5.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    }
}
